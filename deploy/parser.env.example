# Optional POS80 beeper notification as soon as a new, complete POS COMANDA is
# recognized by the bounded OCR-free preclassification pass. Full parsing and
# OCR continue independently. It is disabled until explicitly approved.
RPG_POS_BEEPER_ENABLED=false

# POS80K ESC/POS parameters: count 1..63; ON/OFF are 0..25500 ms and must be
# multiples of 100 ms. These defaults produce three 300 ms beeps with 200 ms
# pauses. The target address/port comes from the matching enabled POS device.
RPG_POS_BEEPER_COUNT=3
RPG_POS_BEEPER_ON_MS=300
RPG_POS_BEEPER_OFF_MS=200

# Delivery is best effort and isolated from parsing. Each POS has its own
# bounded queue, so one offline printer cannot block other printers or parsing.
# Polling defaults to 250 ms for ingestion and parser; the runtime emits a
# warning whenever capture-to-queue latency exceeds the 2-second budget.
RPG_POS_BEEPER_CONNECT_TIMEOUT_SECONDS=1.0
RPG_POS_BEEPER_QUEUE_SIZE_PER_DEVICE=64
