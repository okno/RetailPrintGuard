[Unit]
Description=RetailPrintGuard bounded document parser worker
Wants=mariadb.service
After=mariadb.service retailprintguard-ingestion.service
PartOf=retailprintguard.target

[Service]
Type=simple
User=retailprintguard-worker
Group=retailprintguard-worker
UMask=0027
Environment=PYTHONUNBUFFERED=1
Environment=RPG_CONFIG=/etc/retailprintguard/config.yaml
Environment=RPG_POS_OCR_LANG=ita+eng
EnvironmentFile=/etc/retailprintguard/database.env
ExecStart=/opt/retailprintguard/current/.venv/bin/retailprintguard-parser --config /etc/retailprintguard/config.yaml --json-logs
Restart=on-failure
RestartSec=5s
TimeoutStopSec=45s
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
RestrictAddressFamilies=AF_UNIX AF_INET
SystemCallArchitectures=native
CapabilityBoundingSet=
ReadWritePaths=/var/lib/retailprintguard/state /var/log/retailprintguard/worker

[Install]
WantedBy=retailprintguard.target
