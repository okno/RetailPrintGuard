[Unit]
Description=RetailPrintGuard transparent POS proxy
Wants=network-online.target
After=network-online.target
PartOf=retailprintguard.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=retailprintguard-pos-proxy
Group=retailprintguard-spool
UMask=0027
Environment=PYTHONUNBUFFERED=1
Environment=RPG_CONFIG=/etc/retailprintguard/config.yaml
UnsetEnvironment=RPG_DATABASE_URL RPG_JWT_SECRET_FILE
ExecStartPre=/opt/retailprintguard/current/.venv/bin/retailprintguard-proxy --config /etc/retailprintguard/config.yaml --device-type pos --check-config
ExecStart=/opt/retailprintguard/current/.venv/bin/retailprintguard-proxy --config /etc/retailprintguard/config.yaml --device-type pos
Restart=on-failure
RestartSec=2s
TimeoutStopSec=30s
KillSignal=SIGTERM
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
RestrictAddressFamilies=AF_UNIX AF_INET
SystemCallArchitectures=native
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
ReadWritePaths=/var/lib/retailprintguard/spool /var/log/retailprintguard/proxy
LimitNOFILE=65536

[Install]
WantedBy=retailprintguard.target
