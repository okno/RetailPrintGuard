[Unit]
Description=RetailPrintGuard evidence ingestion worker
Wants=network-online.target mariadb.service
After=network-online.target mariadb.service
PartOf=retailprintguard.target

[Service]
Type=simple
User=retailprintguard-worker
Group=retailprintguard-worker
SupplementaryGroups=retailprintguard-spool
UMask=0027
Environment=PYTHONUNBUFFERED=1
Environment=RPG_CONFIG=/etc/retailprintguard/config.yaml
EnvironmentFile=/etc/retailprintguard/database.env
EnvironmentFile=-/etc/retailprintguard/ingestion.env
ExecStart=/opt/retailprintguard/current/scripts/run_ingestion.sh
Restart=on-failure
RestartSec=5s
TimeoutStopSec=45s
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
RestrictAddressFamilies=AF_UNIX AF_INET
SystemCallArchitectures=native
CapabilityBoundingSet=
ReadOnlyPaths=/var/lib/retailprintguard/spool
ReadWritePaths=/var/lib/retailprintguard/archive /var/lib/retailprintguard/state /var/log/retailprintguard/worker

[Install]
WantedBy=retailprintguard.target
